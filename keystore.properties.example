# Copiá este archivo como `keystore.properties` (git lo ignora) y generá el keystore:
#
#   keytool -genkeypair -keystore truco-release.jks -alias truco \
#     -keyalg RSA -keysize 4096 -validity 10950 \
#     -dname "CN=Truco Argentino, O=Truco Argentino, C=AR"
#
# Guardá el .jks y estas claves: sin ellas no se pueden publicar actualizaciones
# del APK (Android exige la misma firma para actualizar una app instalada).
storeFile=truco-release.jks
storePassword=cambiame
keyAlias=truco
keyPassword=cambiame
